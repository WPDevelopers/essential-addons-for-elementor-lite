<?xml version="1.0"?>
<ruleset name="Essential Addons Coding Standards">
	<description>PHP Coding Standards for Essential Addons for Elementor.</description>

	<!-- Scan these files -->
	<file>.</file>

	<!-- Exclude paths -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/tools/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/docs/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>

	<!-- Show file path in output -->
	<arg value="sp"/>
	<!-- Show sniff codes in all reports -->
	<arg name="report-width" value="120"/>
	<!-- Strip the filepaths down to the relevant bit. -->
	<arg name="basepath" value="."/>
	<!-- Check up to 8 files simultaneously. -->
	<arg name="parallel" value="8"/>
	<!-- Only check PHP files. -->
	<arg name="extensions" value="php"/>
	<!-- Use colors -->
	<arg name="colors"/>

	<!-- WordPress Coding Standards - Core rules only (formatting & naming) -->
	<rule ref="WordPress-Core">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
		<exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
		<exclude name="WordPress.NamingConventions.ValidHookName.UseUnderscores"/>
	</rule>

	<!-- Text domain for i18n -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="essential-addons-for-elementor-lite"/>
			</property>
		</properties>
	</rule>

	<!-- Flag syntax/APIs newer than the advertised PHP floor. Without this rule
	     the testVersion below is inert config. -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- Minimum PHP version support — must match the advertised floor in readme.txt
	     ("Requires PHP: 7.0"). If changed code legitimately needs newer syntax,
	     bump the advertised requirement here and in readme.txt together. -->
	<config name="testVersion" value="7.0-"/>

	<!-- Minimum WordPress version -->
	<config name="minimum_wp_version" value="5.6"/>

	<!-- WordPress Extra rules - covers common mistakes & best practices -->
	<!-- <rule ref="WordPress-Extra"/> -->

	<!-- Full WordPress ruleset including docs -->
	<!-- <rule ref="WordPress-Docs"/> -->

	<!-- Security-focused rules -->
	<rule ref="WordPress.Security.EscapeOutput"/>
	<rule ref="WordPress.Security.NonceVerification"/>
	<rule ref="WordPress.Security.ValidatedSanitizedInput"/>

	<!-- Database query rules — SQL-injection class. Enforced on changed files via CI. -->
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<!-- Caching/schema-change advisories are noisy in a plugin context; keep the
		     injection-relevant sniffs (unprepared queries) which PreparedSQL covers. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>
	</rule>

</ruleset>
