{
  "name": "essential-addons-for-elementor",
  "version": "6.8.2",
  "description": "=== Essential Addons for Elementor ===\r Contributors: wpdevteam, Codetic, re_enter_rupok, Asif2BD, priyomukul, mahfuz01, nazsabuz\r Tags: elementor, elements, addons, elementor addon, elementor widget, page builder, builder, visual editor, wordpress page builder, elementor form\r Requires at least: 4.0\r Tested up to: 5.2\r Requires PHP: 5.4\r Stable tag: 3.3.0\r License: GPLv3\r License URI: https://opensource.org/licenses/GPL-3.0",
  "engines": {
    "node": "^20.20.0"
  },
  "scripts": {
    "dev": "webpack --mode production --watch",
    "build": "webpack --mode production && webpack --mode development && npm run build:angie",
    "build:angie": "esbuild src/js/admin/angie-integration.js --bundle --format=iife --minify --outfile=assets/admin/js/angie-integration.min.js --metafile=.angie-bundle-meta.json && npm run verify:angie",
    "format": "prettier --write 'src/**/*.{js,scss,css,json}'",
    "format:check": "prettier --check 'src/**/*.{js,scss,css,json}'",
    "prepare": "husky",
    "test:setup": "wp-env start && wp-env run cli bash /var/www/html/wp-content/plugins/essential-addons-for-elementor-lite/tests/e2e/utils/seed.sh",
    "test:reset": "echo y | wp-env destroy && npm run test:setup",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "verify:angie": "node bin/verify-angie-bundle.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rupok/essential-addons-for-elementor-lite.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rupok/essential-addons-for-elementor-lite/issues"
  },
  "homepage": "https://github.com/rupok/essential-addons-for-elementor-lite#readme",
  "devDependencies": {
    "@babel/cli": "^7.7.7",
    "@elementor/angie-sdk": "1.5.2",
    "@modelcontextprotocol/sdk": "1.27.0",
    "esbuild": "0.23.1",
    "zod": "3.25.76",
    "@babel/core": "^7.8.6",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/preset-env": "^7.8.6",
    "@playwright/test": "^1.58.2",
    "@wordpress/env": "^11.2.0",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^8.0.6",
    "css-loader": "^7.1.5",
    "glob": "^7.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mini-css-extract-plugin": "^0.9.0",
    "postcss-import": "^17.0.0",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.2.0",
    "sass": "^1.26.3",
    "sass-loader": "^8.0.2",
    "webpack": "^4.42.1",
    "webpack-cli": "^3.3.10",
    "wp-pot": "^1.9.3"
  },
  "dependencies": {
    "@wordpress/hooks": "^2.6.0"
  }
}
